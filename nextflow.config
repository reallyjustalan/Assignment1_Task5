params {
    samples = "${projectDir}/samples.csv"
    genome = '/home/ubuntu/fastq/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa'
    gtf = '/home/ubuntu/fastq/Homo_sapiens.GRCh38.91.gtf'
    mode = 'annotated'
    outdir = "${projectDir}/results"
    min_reads = 100000
    min_mapped_pct = 70
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
}
executor {
    cpus = 8
    memory = '54 GB'
}
env {
    R_LIBS_USER = '/home/ubuntu/R/library'
    // Prevent numerical libraries from spawning unbudgeted worker threads.
    OPENBLAS_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
}
